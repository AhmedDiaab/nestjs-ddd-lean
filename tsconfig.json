{
    "extends": "./tsconfig.path.json",
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "resolvePackageJsonExports": true,
        "esModuleInterop": true,
        "isolatedModules": true,
        "declaration": true,
        "removeComments": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "target": "ES2023",
        "sourceMap": true,
        "outDir": "./dist",
        "incremental": true,
        "skipLibCheck": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "noFallthroughCasesInSwitch": false,
        "typeRoots": ["./node_modules/@types", "./src/infrastructure/auth/types"],
        "types": ["node", "jest"]
    },
    "exclude": ["node_modules", "dist", "coverage", "scripts/rename-project.mts"]
}

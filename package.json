{
    "name": "nestjs-ddd-lean",
    "version": "1.0.0",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22.18.0",
        "pnpm": ">=10.15.0"
    },
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "cross-env NODE_ENV=development nest start --watch",
        "start:repl": "cross-env NODE_ENV=development nest start --entryFile repl",
        "start:debug": "cross-env NODE_ENV=development nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs}/**/*.ts\" --ignore-pattern \"**/*.spec.ts\"",
        "lint:test": "eslint \"test/**/*.ts\"",
        "lint:fix": "eslint . --fix",
        "check:circular": "madge src --circular --warning --no-spinner",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p scripts/tsconfig.json",
        "verify": "pnpm typecheck && pnpm lint && pnpm lint:test && pnpm check:circular && pnpm test && pnpm test:e2e && pnpm build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"**/*.{ts,js,json,md,html,css,yml,yaml}\"",
        "rename-project": "node scripts/rename-project.mts",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:oracle": "jest --config ./test/jest-integration.json --runInBand",
        "test:service-scripts": "docker run --rm --platform linux/amd64 -v \"$PWD\":/repo:ro mcr.microsoft.com/powershell:lts-alpine-3.20 pwsh -NoProfile -File /repo/test/windows-service/service-scripts.tests.ps1"
    },
    "dependencies": {
        "@nestjs/common": "^11.0.1",
        "@nestjs/core": "^11.0.1",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "^11.2.1",
        "cookie-parser": "^1.4.7",
        "dotenv-flow": "^4.1.0",
        "helmet": "^8.1.0",
        "nestjs-pino": "^4.4.1",
        "oracledb": "^6.10.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "pino": "^10.0.0",
        "pino-http": "^11.0.0",
        "pino-roll": "^4.0.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "zod": "^4.1.12"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@ianvs/prettier-plugin-sort-imports": "^4.7.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.10.7",
        "@types/oracledb": "^6.9.1",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.2",
        "cross-env": "^10.1.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^30.0.0",
        "madge": "^8.0.0",
        "pino-pretty": "^13.1.2",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "packageManager": "pnpm@10.15.0"
}
